FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv build-essential git tar \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agentsinc
COPY backend/requirements.txt /opt/agentsinc/backend/requirements.txt
RUN pip3 install --break-system-packages --no-cache-dir -r /opt/agentsinc/backend/requirements.txt

COPY frontend/package.json frontend/package-lock.json /opt/agentsinc/frontend/
RUN cd /opt/agentsinc/frontend && npm ci --ignore-scripts=false

WORKDIR /tmp
