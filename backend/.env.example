# Optional: leave blank to auto-select an installed Ollama model.
AGENTSINC_OLLAMA_MODEL=

# Local Ollama only. Do not expose this service on a public network.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SQLite database persists on this computer.
# AGENTSINC_DB_PATH=./data/agentsinc.sqlite3

AGENTSINC_WORKER_POLL_SECONDS=2
AGENTSINC_MODEL_TIMEOUT_SECONDS=900

# Optional Google Search grounding for the Research Agent.
# Create a Gemini API key in Google AI Studio; this integration is opt-in.
# Free-tier limits and data handling are controlled by Google and may change.
AGENTSINC_GOOGLE_SEARCH_ENABLED=false
GEMINI_API_KEY=
AGENTSINC_GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# Agent Harness: role-scoped local tools. Set false to restore the read-only legacy worker.
AGENTSINC_AGENT_HARNESS_ENABLED=true

# Local Docker image for network-isolated tests; build with:
# docker build -t agentsinc-sandbox:local -f backend/Dockerfile.sandbox .
AGENTSINC_SANDBOX_IMAGE=agentsinc-sandbox:local

# Optional official GitHub MCP connection (Docker Desktop required).
# Put the token value only in this local .env file; never commit it or paste it into chat.
# Prefer a fine-grained token restricted to the AgentSINC repository with Contents: write
# and Pull requests: write. The Tester receives read-only tools; only Developer gets writes.
# See ../docs/GITHUB_DEVELOPMENT_WORKFLOW.md for the complete JSON configuration.
GITHUB_PERSONAL_ACCESS_TOKEN=
# MCP configuration supports per-role tool grants. Example:
# AGENTSINC_MCP_SERVERS_JSON='[{"name":"github","transport":"stdio","command":"docker","args":["run","-i","--rm","-e","GITHUB_PERSONAL_ACCESS_TOKEN","-e","GITHUB_TOOLSETS=repos,pull_requests,users","ghcr.io/github/github-mcp-server"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"${GITHUB_PERSONAL_ACCESS_TOKEN}","GITHUB_TOOLSETS":"repos,pull_requests,users"},"roles":["developer","tester"],"allow_tools":["get_me","search_repositories","get_file_contents","list_branches","get_commit","list_pull_requests","pull_request_read","create_branch","push_files","create_pull_request"],"read_only_tools":["get_me","search_repositories","get_file_contents","list_branches","get_commit","list_pull_requests","pull_request_read"],"role_allow_tools":{"developer":["get_me","search_repositories","get_file_contents","list_branches","get_commit","list_pull_requests","pull_request_read","create_branch","push_files","create_pull_request"],"tester":["get_me","search_repositories","get_file_contents","list_branches","get_commit","list_pull_requests","pull_request_read"]}}]'
AGENTSINC_MCP_SERVERS_JSON=
