# Optional: leave blank to auto-select an installed Ollama model.
AGENTSINC_OLLAMA_MODEL=

# Local Ollama only. Do not expose this service on a public network.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SQLite database persists on this computer.
# AGENTSINC_DB_PATH=./data/agentsinc.sqlite3

AGENTSINC_WORKER_POLL_SECONDS=2
AGENTSINC_MODEL_TIMEOUT_SECONDS=900

# Optional Google Search grounding for the Research Agent.
# Create a Gemini API key in Google AI Studio; this integration is opt-in.
# Free-tier limits and data handling are controlled by Google and may change.
AGENTSINC_GOOGLE_SEARCH_ENABLED=false
GEMINI_API_KEY=
AGENTSINC_GOOGLE_SEARCH_MODEL=gemini-2.5-flash

# Agent Harness: role-scoped local tools. Set false to restore the read-only legacy worker.
AGENTSINC_AGENT_HARNESS_ENABLED=true

# Local Docker image for network-isolated tests; build with:
# docker build -t agentsinc-sandbox:local -f backend/Dockerfile.sandbox .
AGENTSINC_SANDBOX_IMAGE=agentsinc-sandbox:local

# Optional MCP registry: every server requires explicit roles and tool allowlists.
# Use ${ENV_VAR} references for secrets. Never paste credentials directly into this JSON.
# Example: [{"name":"github","transport":"stdio","command":"npx","args":["-y","@modelcontextprotocol/server-github"],"env":{"GITHUB_PERSONAL_ACCESS_TOKEN":"${GITHUB_PERSONAL_ACCESS_TOKEN}"},"roles":["developer","tester"],"allow_tools":["search_repositories","get_file_contents","create_or_update_file"],"read_only_tools":["search_repositories","get_file_contents"]}]
AGENTSINC_MCP_SERVERS_JSON=
