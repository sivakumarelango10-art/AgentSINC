# Optional: leave blank to auto-select an installed Ollama model.
AGENTSINC_OLLAMA_MODEL=

# Local Ollama only. Do not expose this service on a public network.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# SQLite database persists on this computer.
# AGENTSINC_DB_PATH=./data/agentsinc.sqlite3

AGENTSINC_WORKER_POLL_SECONDS=2
AGENTSINC_MODEL_TIMEOUT_SECONDS=900

# Optional Google Search grounding for the Research Agent.
# Create a Gemini API key in Google AI Studio; this integration is opt-in.
# Free-tier limits and data handling are controlled by Google and may change.
AGENTSINC_GOOGLE_SEARCH_ENABLED=false
GEMINI_API_KEY=
AGENTSINC_GOOGLE_SEARCH_MODEL=gemini-2.5-flash
